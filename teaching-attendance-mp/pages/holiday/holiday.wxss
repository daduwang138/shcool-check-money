.page {
  padding: 16rpx 0 40rpx;
}

/* ---------- 年份 ---------- */
.yearbar {
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav {
  width: 60rpx;
  height: 60rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #4C5057;
  font-size: 32rpx;
  line-height: 56rpx;
  text-align: center;
}

.nav-hover {
  background: #FAF9F4;
}

.yr {
  padding: 0 30rpx;
  color: #191C20;
  font-size: 32rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.note {
  display: block;
  margin-top: 14rpx;
  color: #8A8E96;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}

/* ---------- 列表 ---------- */
.sub {
  display: block;
  margin-top: 6rpx;
  color: #8A8E96;
  font-size: 21rpx;
  line-height: 1.6;
}

.hlist {
  margin-top: 14rpx;
}

.hrow {
  display: flex;
  align-items: center;
  padding: 13rpx 0;
  border-bottom: 1rpx solid #F1EFE8;
}

.hrow:last-child {
  border-bottom: 0;
}

.hrow-t {
  flex: 1;
  color: #191C20;
  font-size: 26rpx;
}

.hrow-x {
  padding: 4rpx 12rpx;
  color: #A33A28;
  font-size: 30rpx;
  line-height: 1;
}

.empty {
  display: block;
  padding: 12rpx 0;
  color: #B4B2A9;
  font-size: 23rpx;
}

/* ---------- 添加一行 ---------- */
.addrow {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F1EFE8;
}

.dt {
  display: flex;
  min-width: 104rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #191C20;
  font-size: 26rpx;
  font-variant-numeric: tabular-nums;
}

.to {
  padding: 0 12rpx;
  color: #8A8E96;
  font-size: 23rpx;
}

.add {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-left: auto;
  padding: 0 28rpx;
  border: 1rpx solid #174C7C;
  border-radius: 12rpx;
  background: #1B5E9B;
  color: #FFFFFF;
  font-size: 25rpx;
}

.add:active {
  opacity: .82;
}

/* ---------- 提示与收尾 ---------- */
.warn {
  margin: 0 24rpx 20rpx;
  padding: 18rpx 22rpx;
  border: 1rpx solid #F0DFC9;
  border-radius: 16rpx;
  background: #FDF8EF;
  color: #854F0B;
  font-size: 21rpx;
  line-height: 1.7;
}

.btn.full {
  margin: 0 24rpx 22rpx;
}

/* ---------- 从电脑粘贴导入 ---------- */
.paste-box {
  margin: 0 24rpx 22rpx;
  padding: 20rpx 22rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.paste-t {
  display: block;
  color: #191C20;
  font-size: 25rpx;
  font-weight: 500;
}

.paste-sub {
  display: block;
  margin-top: 6rpx;
  color: #7C8188;
  font-size: 21rpx;
  line-height: 1.65;
}

.paste-ta {
  width: 100%;
  height: 220rpx;
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FAF9F4;
  color: #2E3238;
  font-size: 22rpx;
  line-height: 1.6;
}

.paste-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.paste-btns .btn {
  flex: 1;
  margin: 0;
}

.tips {
  padding: 2rpx 24rpx 0;
  color: #8A8E96;
  font-size: 21rpx;
  line-height: 1.7;
}
