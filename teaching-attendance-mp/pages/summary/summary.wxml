<view class="page">
  <view class="mode-tabs">
    <view class="mt {{mode === 'month' ? 'on' : ''}}" data-mode="month" bindtap="setMode">月度</view>
    <view class="mt {{mode === 'year' ? 'on' : ''}}" data-mode="year" bindtap="setMode">年度</view>
  </view>

  <view class="topbar" wx:if="{{mode === 'month'}}">
    <view class="nav" bindtap="prevMonth" hover-class="nav-hover">‹</view>
    <picker mode="date" fields="month" value="{{ym}}" bindchange="pickMonth">
      <view class="mon">{{monLabel}}<text class="caret">▾</text></view>
    </picker>
    <view class="nav" bindtap="nextMonth" hover-class="nav-hover">›</view>
  </view>
  <view class="topbar" wx:else>
    <view class="nav" bindtap="prevYear" hover-class="nav-hover">‹</view>
    <picker mode="date" fields="year" value="{{yearLabel}}" bindchange="pickYear">
      <view class="mon">{{yearLabel}}<text class="caret">▾</text></view>
    </picker>
    <view class="nav" bindtap="nextYear" hover-class="nav-hover">›</view>
  </view>

  <!-- 年度：四标签切换（应发总览 / 出勤 / 课时 / 晚修） -->
  <view class="year-tabs" wx:if="{{mode === 'year'}}">
    <view class="yt {{yearTab === item.k ? 'on' : ''}}" wx:for="{{yearTabs}}" wx:key="k"
      data-tab="{{item.k}}" bindtap="setYearTab">{{item.t}}</view>
  </view>

  <view class="hero">
    <text class="hero-label">{{mode === 'year' ? yearHead.label : '本月应发'}}</text>
    <view class="hero-num">
      <text class="cur" wx:if="{{mode === 'month' || yearHead.cur}}">{{mode === 'month' ? '¥' : yearHead.cur}}</text>
      <text class="amt">{{mode === 'year' ? yearHead.value : total}}</text>
    </view>
    <view class="hero-sub">
      <text class="hs" wx:if="{{mode === 'month'}}" wx:for="{{heroSubs}}" wx:key="k">{{item.k}} {{item.v}}</text>
      <text class="hs" wx:else>{{yearHead.sub}}</text>
    </view>
  </view>

  <!-- 年度：构成卡片（应发=①②③④，出勤=状态，课时=档位，晚修=次数金额小时） -->
  <view class="year-cards" wx:if="{{mode === 'year'}}">
    <view class="yc" wx:for="{{yearCards}}" wx:key="k">
      <text class="yc-k">{{item.k}}</text>
      <text class="yc-v">{{item.v}}</text>
    </view>
  </view>

  <block wx:if="{{mode === 'month'}}">
    <view class="halves-card">
      <view class="hb" wx:for="{{halfRows}}" wx:key="k">
        <view class="hb-dot {{item.cls}}"></view>
        <text class="hb-k">{{item.k}}</text>
        <text class="hb-v">{{item.v}}<text class="hb-u"> 天</text></text>
      </view>
    </view>

    <view class="card">
      <text class="card-title">计算过程</text>
      <view class="row" wx:for="{{rows}}" wx:key="k">
        <text class="row-label">{{item.k}}</text>
        <text class="row-value">{{item.v}}</text>
      </view>
    </view>
  </block>

  <view class="card" wx:if="{{noteRows.length}}">
    <text class="card-title">本月事项</text>
    <view class="note-row" wx:for="{{noteRows}}" wx:key="key">
      <view class="nr-head">
        <text class="nr-date">{{item.date}}</text>
        <text class="nr-weekend" wx:if="{{item.weekend}}">周末</text>
        <text class="nr-meta">{{item.meta}}</text>
      </view>
      <text class="nr-text">{{item.note}}</text>
    </view>
    <text class="nr-tip">只列写了备注的日子；周末监考、加班到底是哪场考试，月底一眼能翻到</text>
  </view>

  <view class="card" wx:if="{{ghostDays > 0}}">
    <text class="card-title">待确认</text>
    <view class="row">
      <text class="row-label">默认推算</text>
      <text class="row-value">{{ghostDays}} 天</text>
    </view>
    <view class="row wrap">
      <text class="row-label">说明</text>
      <text class="row-value param-ro">这些天是系统按工作日推的上班，尚未点开确认；请假或调休请先改日历</text>
    </view>
  </view>

  <!-- 年度：逐月横条，按当前标签的值缩放；点一行回到该月 -->
  <view class="card" wx:if="{{mode === 'year' && yearBars.length}}">
    <text class="card-title">逐月{{yearTab === 'pay' ? '应发' : (yearTab === 'att' ? '出勤' : (yearTab === 'les' ? '课时' : '晚修'))}} · 点一行看该月</text>
    <view class="ybar" wx:for="{{yearBars}}" wx:key="ym" data-ym="{{item.ym}}" bindtap="openYearMonth">
      <text class="yb-label">{{item.label}}</text>
      <view class="yb-track"><view class="yb-fill" style="width:{{item.pct}}%"></view></view>
      <text class="yb-value">{{item.value}} ›</text>
    </view>
    <text class="param-hint">横条按当月数值相对全年最高月缩放；每月工资和单价取当月冻结值。</text>
  </view>
  <view class="card" wx:if="{{mode === 'year' && !yearBars.length}}">
    <text class="empty-tip">{{yearEmpty}}</text>
  </view>

  <view class="card" wx:if="{{mode === 'month'}}">
    <text class="card-title">本月参数</text>
    <view class="row">
      <text class="row-label">应上班天数</text>
      <input class="num-in" type="number" value="{{p.workdays}}" bindblur="setWorkdays" />
    </view>
    <view class="row">
      <text class="row-label">本月基本工资（元）</text>
      <input class="num-in {{enableBase ? '' : 'dim'}}" type="digit" value="{{p.base}}" bindblur="setBase"
        disabled="{{!enableBase}}" />
    </view>
    <view class="row">
      <text class="row-label">课时单价（元/节）</text>
      <input class="num-in {{enableLesson ? '' : 'dim'}}" type="digit" value="{{p.rate}}" bindblur="setRate"
        disabled="{{!enableLesson}}" />
    </view>
    <view class="row" wx:if="{{otherRates}}">
      <text class="row-label">其他档位</text>
      <text class="row-value param-ro">{{otherRates}}</text>
    </view>
    <view class="row" wx:if="{{nightEach}}">
      <text class="row-label">晚修监考</text>
      <text class="row-value param-ro">{{nightEach}}</text>
    </view>
    <text class="param-hint">记过账的月份会冻住当时的工资和单价；上面的输入框改完，点一下别处才生效。</text>
    <text class="base-diff" wx:if="{{baseDiff}}">本月按 ¥{{p.base}} 算（记账时冻结），设置里现在是 ¥{{settingBase}}。两处数字不同是刻意的：改设置不会重算已记账的月份。要改这个月，直接改上面的输入框，或点下面这一条。</text>
    <view class="note-action hot" wx:if="{{baseDiff}}" bindtap="useSettingBase">{{resetLabel}}</view>
    <text class="param-off" wx:if="{{!enableBase || !enableLesson}}">设置里关掉了基本工资或课时费，对应这项不计入本月，灰掉的输入框先锁住；要改请先到设置页打开开关</text>
    <view class="note-action" wx:if="{{!baseDiff}}" bindtap="resetParams">{{resetLabel}}</view>
  </view>

  <view class="card" wx:if="{{mode === 'month'}}">
    <view class="row">
      <view>
        <text class="row-label">标记为已核对</text>
        <text class="sub">核对后再改会二次确认，防止手误</text>
      </view>
      <switch checked="{{checked}}" bindchange="toggleChecked" color="#1B5E9B" />
    </view>
    <view class="row">
      <text class="row-label">本月有记录的天数</text>
      <text class="row-value">{{dayCount}} 天</text>
    </view>
  </view>
  <view class="card" wx:else>
    <view class="row">
      <text class="row-label">全年有记录的天数</text>
      <text class="row-value">{{dayCount}} 天</text>
    </view>
    <view class="row">
      <text class="row-label">已核对月份</text>
      <text class="row-value">{{checkedMonths}} 个月</text>
    </view>
  </view>

  <view class="export">
    <view class="btn primary" bindtap="copySum" wx:if="{{mode === 'month'}}">复制工资核对单</view>
    <view class="btn" bindtap="exportPick">导出统计表</view>
  </view>

  <view class="tips">
    <text>「复制工资核对单」把出勤、课时、应发拼成一段话，可直接粘给财务或发给自己，和电脑版复制的内容一字不差。</text>
  </view>
  <view class="tips">
    <text>导出的 CSV 用 Excel / WPS 直接打开，含月度汇总与每日明细两段；可选本月、近三个月、今年或全部记录。手机端会生成文件并转为「发送给聊天」，存到文件传输助手后可在电脑上使用。</text>
  </view>
</view>
