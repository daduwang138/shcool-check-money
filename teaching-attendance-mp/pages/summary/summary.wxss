.page {
  padding: 16rpx 0 40rpx;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 0 24rpx 12rpx;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #4C5057;
  font-size: 34rpx;
  line-height: 60rpx;
  text-align: center;
}

.nav-hover {
  background: #FAF9F4;
}

.mon {
  padding: 0 22rpx;
  color: #191C20;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.caret {
  margin-left: 8rpx;
  color: #B4B2A9;
  font-size: 22rpx;
}

.hero {
  margin: 0 24rpx 20rpx;
  padding: 30rpx 30rpx 26rpx;
  border: 1rpx solid #DCE7F1;
  border-radius: 24rpx;
  background: #F7FBFF;
}

.hero-label {
  color: #5C6B7A;
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero-num {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

.cur {
  color: #1B5E9B;
  font-size: 30rpx;
  font-weight: 500;
}

.amt {
  margin-left: 4rpx;
  color: #14395C;
  font-size: 66rpx;
  font-weight: 500;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.hero-sub {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hs {
  margin-right: 22rpx;
  color: #5C6B7A;
  font-size: 22rpx;
}

.halves-card {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 18rpx 10rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.hb {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.hb-dot {
  width: 26rpx;
  height: 26rpx;
  margin-bottom: 8rpx;
  border-radius: 6rpx;
}

.hb-k {
  color: #8A8E96;
  font-size: 21rpx;
}

.hb-v {
  color: #191C20;
  font-size: 30rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.hb-u {
  color: #8A8E96;
  font-size: 19rpx;
  font-weight: 400;
}

.row {
  padding: 14rpx 0;
}

.sub {
  display: block;
  margin-top: 2rpx;
  color: #8A8E96;
  font-size: 21rpx;
}

.num-in {
  width: 220rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #191C20;
  font-size: 27rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 参数卡里的只读行：档位价、晚修价可能较长，允许折行，别把标签挤没 */
.param-ro {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  color: #6A6F77;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

.param-note {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border: 1rpx dashed #E4E1D8;
  border-radius: 12rpx;
  background: #FAF9F4;
  color: #666B73;
  font-size: 21rpx;
  text-align: center;
}

.export {
  display: flex;
  padding: 4rpx 24rpx 0;
}

.export .btn {
  flex: 1;
  margin-right: 12rpx;
}

.export .btn:last-child {
  margin-right: 0;
}

.tips {
  padding: 18rpx 24rpx 0;
  color: #8A8E96;
  font-size: 21rpx;
  line-height: 1.75;
}
