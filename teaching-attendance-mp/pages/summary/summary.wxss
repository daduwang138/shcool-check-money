.page {
  padding: 16rpx 0 40rpx;
}

/* 月度 / 年度切换：默认停在月度，年度是用户主动选的第二个视角 */
.mode-tabs {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 14rpx;
}
.mt {
  padding: 10rpx 30rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #656A72;
  font-size: 24rpx;
}
.mt.on {
  border-color: #1B5E9B;
  background: #EDF4FA;
  color: #1B5E9B;
  font-weight: 600;
}

/* 年度四标签：应发是总览，其余三个是构成下钻 */
.year-tabs {
  display: flex;
  gap: 8rpx;
  padding: 0 24rpx 12rpx;
}
.yt {
  flex: 1;
  padding: 14rpx 4rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 12rpx;
  background: #FFFFFF;
  color: #656A72;
  font-size: 22rpx;
  text-align: center;
}
.yt.on {
  border-color: #1B5E9B;
  background: #EDF4FA;
  color: #1B5E9B;
  font-weight: 600;
}

/* 年度构成卡：2×2，比列表更省纵向空间 */
.year-cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  padding: 0 24rpx 4rpx;
}
.yc {
  background: #FFFFFF;
  border: 1rpx solid #E7E5DD;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
}
.yc-k {
  display: block;
  color: #8A8377;
  font-size: 20rpx;
  margin-bottom: 6rpx;
}
.yc-v {
  display: block;
  color: #3C4046;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* 年度逐月横条：月份 + 比例条 + 数值，一眼看出淡旺季 */
.ybar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0EEE7;
}
.ybar:last-of-type { border-bottom: none; }
.yb-label {
  width: 72rpx;
  flex-shrink: 0;
  color: #4C5057;
  font-size: 22rpx;
}
.yb-track {
  flex: 1;
  height: 14rpx;
  background: #EEF1F4;
  border-radius: 999rpx;
  overflow: hidden;
}
.yb-fill {
  height: 100%;
  background: #1B5E9B;
  border-radius: 999rpx;
}
.yb-value {
  width: 180rpx;
  flex-shrink: 0;
  text-align: right;
  color: #3C4046;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}
.empty-tip {
  display: block;
  padding: 28rpx 0;
  color: #8A8377;
  font-size: 24rpx;
  text-align: center;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 0 24rpx 12rpx;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 12rpx;
  background: #FFFFFF;
  color: #4C5057;
  font-size: 34rpx;
  line-height: 60rpx;
  text-align: center;
}

.nav-hover {
  background: #FAF9F4;
}

.mon {
  padding: 0 22rpx;
  color: #191C20;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.caret {
  margin-left: 8rpx;
  color: #B4B2A9;
  font-size: 22rpx;
}

.hero {
  margin: 0 24rpx 20rpx;
  padding: 30rpx 30rpx 26rpx;
  border: 1rpx solid #DCE7F1;
  border-radius: 18rpx;
  background: #F7FBFF;
}

.hero-label {
  color: #5C6B7A;
  font-size: 23rpx;
  letter-spacing: 1rpx;
}

.hero-num {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

.cur {
  color: #1B5E9B;
  font-size: 30rpx;
  font-weight: 500;
}

.amt {
  margin-left: 4rpx;
  color: #14395C;
  font-size: 66rpx;
  font-weight: 500;
  letter-spacing: -1rpx;
  font-variant-numeric: tabular-nums;
}

.hero-sub {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hs {
  margin-right: 22rpx;
  color: #5C6B7A;
  font-size: 22rpx;
}

.halves-card {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 18rpx 10rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 18rpx;
  background: #FFFFFF;
}

.hb {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.hb-dot {
  width: 26rpx;
  height: 26rpx;
  margin-bottom: 8rpx;
  border-radius: 6rpx;
}

/* 这四个色点以前没有任何底色：.s-work 一类样式只定义在记账页，这里是另一个页面，
   继承不到，于是页面上一排透明方块。色点小，用饱和色而不是格子里的浅底。 */
.hb-dot.s-work {
  background: #2265A3;
}

.hb-dot.s-inv {
  background: #0F6E56;
}

.hb-dot.s-ot {
  background: #A05A00;
}

.hb-dot.s-leave {
  background: #9B4A3C;
}

.hb-k {
  color: #656A72;
  font-size: 21rpx;
}

.hb-v {
  color: #191C20;
  font-size: 30rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.hb-u {
  color: #656A72;
  font-size: 19rpx;
  font-weight: 400;
}

.row {
  padding: 14rpx 0;
}

.sub {
  display: block;
  margin-top: 2rpx;
  color: #656A72;
  font-size: 21rpx;
}

.num-in {
  width: 220rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #191C20;
  font-size: 27rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 参数卡里的只读行：档位价、晚修价可能较长，允许折行，别把标签挤没 */
/* 一整句话不塞进右对齐的数值列：数值右对齐是为了一眼对齐数字，
   句子右对齐每行长度不齐，反而难读。带 .wrap 的行改成上下排。 */
.row.wrap {
  display: block;
  padding: 14rpx 0;
}

.row.wrap .row-label {
  display: block;
  margin-bottom: 6rpx;
  color: #3A3F45;
  font-weight: 600;
}

.row.wrap .param-ro {
  display: block;
  margin-left: 0;
  color: #4C5057;
  text-align: left;
}

.param-ro {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  color: #6A6F77;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: right;
  word-break: break-all;
}

/* wxss 不跨页继承：settings.wxss 那份 .num-in.dim 到这页不算，得自己再写一遍 */
.num-in.dim {
  border-color: #EAE7DE;
  background: #F4F3EE;
  color: #9C9A91;
}

/* 冻结价的说明常驻，但压得很轻，别抢参数行的视觉 */
.param-hint {
  display: block;
  margin-top: 14rpx;
  color: #656A72;
  font-size: 20rpx;
  line-height: 1.6;
}

/* 只有开关真关了才出现：解释「为什么这行灰着、改了也不算钱」 */
.param-off {
  display: block;
  margin-top: 8rpx;
  color: #8A4B3F;
  font-size: 20rpx;
  line-height: 1.6;
}

/* 单价为 0 的告警：比普通说明重、比错误轻，点了直接去设置页 */
.rate-warn {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-left: 4rpx solid #B3261E;
  border-radius: 6rpx;
  background: #FDF3F1;
}

.rate-warn-t {
  color: #8A2F24;
  font-size: 22rpx;
  line-height: 1.6;
}

/* 设置默认值与本月冻结值不同时，把两个数字并排摆出来：
   同一个字段在两个页面显示不同值，一句常驻灰字解释不清，得单独占一块。 */
.base-diff {
  display: block;
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border-left: 4rpx solid #B4652F;
  border-radius: 6rpx;
  background: #FBF3E9;
  color: #6B3F1C;
  font-size: 21rpx;
  line-height: 1.6;
}

/* 有差异时的一键操作要比常态的回退入口更醒目 */
.note-action.hot {
  border-color: #D9A87B;
  background: #FFF8EF;
  color: #6B3F1C;
  font-weight: 600;
}

/* 带说明的回退操作：整块可点，所以用实线白底（虚线在这个界面里表示「空位/占位」），
   前面加个 ↺ 提示这是「恢复」而不是一段只读说明。 */
.note-action {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FFFFFF;
  color: #3A3F45;
  font-size: 22rpx;
  line-height: 1.6;
}

.note-action::before {
  content: "↺ ";
  color: #2B5C8A;
}

/* 「本月事项」：备注是自由文本，一行放不下就折行，别截断 */
.note-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0EEE7;
}

.nr-head {
  display: flex;
  align-items: baseline;
}

.nr-date {
  margin-right: 12rpx;
  color: #191C20;
  font-size: 26rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* 周末监考/加班正是要回头找的那几天，单独给个小徽标 */
.nr-weekend {
  margin-right: 10rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: #FDF4E3;
  color: #8A5A10;
  font-size: 20rpx;
}

.nr-meta {
  color: #656A72;
  font-size: 20rpx;
}

.nr-text {
  display: block;
  margin-top: 6rpx;
  color: #3A3F45;
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-all;
}

.nr-tip {
  display: block;
  margin-top: 12rpx;
  color: #656A72;
  font-size: 20rpx;
  line-height: 1.6;
}

.export {
  display: flex;
  padding: 4rpx 24rpx 0;
}

.export .btn {
  flex: 1;
  margin-right: 12rpx;
}

.export .btn:last-child {
  margin-right: 0;
}

.tips {
  padding: 18rpx 24rpx 0;
  color: #656A72;
  font-size: 21rpx;
  line-height: 1.75;
}
