.lock {
  display: flex;
  min-height: 100vh;
  padding: 0 56rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #F5F4F0;
}

.lk-icon {
  font-size: 52rpx;
  line-height: 1;
}

.lk-title {
  margin-top: 20rpx;
  color: #2E3238;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.lk-sub {
  margin-top: 10rpx;
  color: #8A8E96;
  font-size: 22rpx;
  text-align: center;
}

.lk-field {
  width: 100%;
  margin-top: 52rpx;
}

.lk-input {
  width: 100%;
  height: 92rpx;
  padding: 0 26rpx;
  box-sizing: border-box;
  border: 1rpx solid #E4E1D8;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #2E3238;
  font-size: 30rpx;
  letter-spacing: 6rpx;
  text-align: center;
}

.lk-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #1B5E9B;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 88rpx;
  text-align: center;
}

.lk-btn.off {
  background: #8AAAC6;
}

.lk-err {
  margin-top: 18rpx;
  color: #A33A28;
  font-size: 22rpx;
}

.lk-wait {
  margin-top: 8rpx;
  color: #A8680E;
  font-size: 22rpx;
}

.lk-forgot {
  margin-top: 40rpx;
  color: #8A8E96;
  font-size: 22rpx;
  text-decoration: underline;
}

.lk-note {
  margin-top: 56rpx;
  padding: 18rpx 22rpx;
  border-radius: 14rpx;
  background: #EDEAE1;
  color: #7A7468;
  font-size: 20rpx;
  line-height: 1.75;
}
