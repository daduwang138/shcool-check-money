.page {
  padding: 16rpx 0 40rpx;
}

.topbar {
  display: flex;
  align-items: center;
  padding: 0 24rpx 8rpx;
}

.nav {
  width: 64rpx;
  height: 64rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 12rpx;
  background: #FFFFFF;
  color: #4C5057;
  font-size: 34rpx;
  line-height: 60rpx;
  text-align: center;
}

.nav-hover {
  background: #FAF9F4;
}

.mon {
  padding: 0 22rpx;
  color: #191C20;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.caret {
  margin-left: 8rpx;
  color: #B4B2A9;
  font-size: 22rpx;
}

.go-today {
  margin-left: auto;
  padding: 8rpx 20rpx;
  border: 1rpx solid #CFE2F2;
  border-radius: 999rpx;
  background: #F2F8FD;
  color: #1B5E9B;
  font-size: 23rpx;
}

.sel-toggle {
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #5F6470;
  font-size: 23rpx;
}

.sel-toggle.on {
  border-color: #174C7C;
  background: #1B5E9B;
  color: #FFFFFF;
}

.page.pad-sel {
  padding-bottom: 380rpx;
}

/* 四张卡等分：不按内容宽度自适应，否则金额一长就把前面几张挤窄 */
.chips {
  display: flex;
  padding: 4rpx 18rpx 0;
}

.chip {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin: 8rpx 6rpx 0;
  padding: 10rpx 12rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.chip-k {
  color: #656A72;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.chip-v {
  color: #191C20;
  font-size: 26rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
  line-height: 1.4;
  white-space: nowrap;
}

/* 金额位数最多，多分半成宽度，字号仍和其它卡一致 */
.chip.chip-wide {
  flex: 1.15;
}

.legend {
  display: flex;
  flex-wrap: wrap;
  padding: 14rpx 24rpx 0;
}

.lg {
  display: flex;
  align-items: center;
  margin: 0 22rpx 6rpx 0;
}

.sw {
  width: 22rpx;
  height: 22rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
}

.lg-t {
  color: #666B73;
  font-size: 22rpx;
}

.weekhead {
  display: flex;
  padding: 6rpx 24rpx 8rpx;
}

.wh {
  flex: 1;
  color: #41474F;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  text-align: center;
}

.wh:nth-child(6),
.wh:nth-child(7) {
  color: #5E5749;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  /* 横向手势留给选日期，纵向仍然能滚页面 */
  touch-action: pan-y;
}

.cell {
  display: flex;
  width: calc((100% - 36rpx) / 7);
  height: 116rpx;
  flex-direction: column;
  margin: 0 6rpx 6rpx 0;
  padding: 6rpx 6rpx 5rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.cell:nth-child(7n) {
  margin-right: 0;
}

.cell.blank {
  border: 0;
  background: transparent;
}

.cell.rest {
  border-color: #EEECE4;
  background: #FBFAF6;
}

.cell.pre {
  border-style: dashed;
  border-color: #DEDCD2;
  background: #F8F7F2;
}

.cell.miss {
  border: 1rpx dashed #A8680E;
  background: #FDF4E3;
}

.cell.today {
  border-color: #7FB3DC;
  background: #F7FBFF;
}

.cell.sel {
  border-color: #174C7C;
  background: #E8F1FA;
  box-shadow: inset 0 0 0 2rpx #2C6FAE;
}

.dnum {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 30rpx;
  line-height: 1;
}

.dn {
  color: #4C5057;
  font-size: 24rpx;
  font-weight: 500;
}

.cell.today .dn {
  display: flex;
  width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1B5E9B;
  color: #FFFFFF;
  font-size: 21rpx;
}

.cd {
  padding: 1rpx 6rpx;
  border: 1rpx solid #E7E5DD;
  border-radius: 999rpx;
  color: #6B6459;
  font-size: 20rpx;
  line-height: 1.5;
}

/* 写了备注的日子：格子只有 107rpx 宽，塞不下中文，用一个小圆点提示「这天记了事」，
   完整内容去汇总页「本月事项」看 */
.note-mark {
  width: 10rpx;
  height: 10rpx;
  flex: none;
  border-radius: 999rpx;
  background: #1B5E9B;
}

.cd-now {
  border-color: #CFE2F2;
  background: #F2F8FD;
  color: #1B5E9B;
}

.cd-pre {
  border-color: #E2E0D8;
  color: #6F6A60;
}

.halves {
  display: flex;
  margin-top: 7rpx;
}

.half {
  height: 26rpx;
  flex: 1;
  border-radius: 6rpx;
}

.half + .half {
  margin-left: 4rpx;
}

.s-empty {
  border: 1rpx dashed #E4E2DA;
  background: #FCFBF8;
}

/* 「上班」是一个月里最常见的状态，用浅底细边压住；
   饱和色让给「这天不一样」（监考/加班/请假），翻月历时一眼挑出要核对的日子。
   面板里的选中按钮另算（.seg.on.s-work），那里需要饱和色表示「已选中」。 */
.s-work {
  border: 1rpx solid #A7C3DC;
  background: #E4EEF7;
}

.s-inv {
  border: 1rpx solid #0F6E56;
  background-color: #C4E4D6;
  background-image: repeating-linear-gradient(45deg, rgba(15, 110, 86, .55) 0, rgba(15, 110, 86, .55) 1.5rpx, rgba(15, 110, 86, 0) 1.5rpx, rgba(15, 110, 86, 0) 5rpx);
}

.s-ot {
  border: 1rpx solid #A05A00;
  background-color: #F7D3A2;
  background-image: radial-gradient(rgba(160, 90, 0, .55) 1rpx, rgba(160, 90, 0, 0) 1.3rpx);
  background-size: 5rpx 5rpx;
}

/* 请假以前是 #E6E4DC 灰，和「空」几乎分不开、又像禁用态；
   换成低饱和砖红，语义是「缺勤」，与「没填」拉开 */
.s-leave {
  border: 1rpx solid #9B4A3C;
  background: #EFD5CE;
}

.half.ghost {
  border: 1rpx dashed #B7D0E6;
  background: #FFFFFF;
}

.cell.rest .half.s-empty {
  border-color: #EAE7DE;
  background: transparent;
}

.les-wrap {
  margin-top: auto;
  align-self: flex-start;
  display: flex;
  align-items: center;
  max-width: 100%;
}

.les {
  margin-top: auto;
  align-self: flex-start;
  padding: 0 5rpx;
  border-radius: 6rpx;
  color: #2B5C8A;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.6;
  background: #F1F5FA;
}

.les-wrap .les {
  margin-top: 0;
  align-self: auto;
}

.les.bare {
  background: transparent;
  padding: 0;
}

.nighttag {
  margin-left: 4rpx;
  padding: 0 5rpx;
  border-radius: 6rpx;
  background: #E7EDF5;
  color: #3F6080;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.7;
}

.les.zero {
  background: transparent;
  color: #74726B;
  font-weight: 500;
}

.les.ghost {
  color: #6F6A60;
}

.notes {
  display: flex;
  flex-direction: column;
  padding: 8rpx 24rpx 0;
}

.note-item {
  color: #854F0B;
  font-size: 22rpx;
  line-height: 1.7;
}

/* 操作区：一条分割线把它和日历分开，主操作单占一行，重置类两项并排 */
.tools {
  display: flex;
  padding: 12rpx 24rpx 0;
}

.tools-main {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #EAE8E0;
}

.tools .btn {
  flex: 1;
  height: 84rpx;
  margin-right: 12rpx;
  font-size: 26rpx;
}

.tools .btn:last-child {
  margin-right: 0;
}

/* 单独一颗按钮不要拉满整行，二级操作不该比主操作还宽 */
.tools-single .btn {
  flex: 0 0 auto;
  padding: 0 40rpx;
}

/* 底部：折叠入口在左、「清空本月」降级成文字链在右。
   危险操作从按钮行里挪出来，既不会被顺手点到，也不会和常用操作抢注意力 */
.foot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 0 24rpx;
}

.howto {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  border: 1rpx solid #E2E0D8;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #4C5057;
  font-size: 23rpx;
}

.howto-mark {
  margin-left: 8rpx;
  color: #1B5E9B;
  font-size: 22rpx;
  font-weight: 600;
}

.danger-link {
  padding: 12rpx 6rpx;
  color: #A33A28;
  font-size: 23rpx;
}

.tips {
  padding: 22rpx 24rpx 0;
  color: #656A72;
  font-size: 22rpx;
  line-height: 1.7;
}

.mask {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(25, 28, 32, .38);
}

.sheet {
  position: fixed;
  max-height: 94vh;
  overflow-y: auto;
  z-index: 60;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18rpx 30rpx 0;
  border-radius: 18rpx 18rpx 0 0;
  background: #FFFFFF;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.sheet-title-wrap {
  flex: 1;
  min-width: 0;
}

.sheet-title {
  display: block;
  color: #191C20;
  font-size: 34rpx;
  font-weight: 500;
}

.sheet-sub {
  display: block;
  margin-top: 4rpx;
  color: #656A72;
  font-size: 24rpx;
}

.sheet-x {
  padding: 4rpx 12rpx;
  color: #B4B2A9;
  font-size: 30rpx;
}

.field {
  margin-top: 12rpx;
}

.field-label {
  display: block;
  margin-bottom: 10rpx;
  color: #666B73;
  font-size: 23rpx;
}

.seg {
  height: 68rpx;
  flex: 1;
  margin-right: 8rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #656A72;
  font-size: 24rpx;
  line-height: 66rpx;
  text-align: center;
}

/* 末项不要右边距，否则整排比卡片右边界缩进 4px */
.seg:last-child {
  margin-right: 0;
}

.seg.on.s-empty {
  border: 1rpx solid #B4B2A9;
  background: #F1EFE8;
  color: #4C5057;
}

.seg.on.s-work {
  border-color: #174C7C;
  background: #2265A3;
  color: #FFFFFF;
}

.seg.on.s-inv {
  border-color: #0F6E56;
  background-color: #C4E4D6;
  background-image: repeating-linear-gradient(45deg, rgba(15, 110, 86, .55) 0, rgba(15, 110, 86, .55) 1.5rpx, rgba(15, 110, 86, 0) 1.5rpx, rgba(15, 110, 86, 0) 5rpx);
  color: #0A4A39;
}

/* 面板里选中后的底色与日历格子里的状态色对齐：选成什么，格子上就是什么 */
.seg.on.s-ot {
  border-color: #A05A00;
  background-color: #F7D3A2;
  background-image: radial-gradient(rgba(160, 90, 0, .55) 1rpx, rgba(160, 90, 0, 0) 1.3rpx);
  background-size: 5rpx 5rpx;
  color: #66390A;
}

.seg.on.s-leave {
  border-color: #9B4A3C;
  background: #EFD5CE;
  color: #5E2A20;
}

/* 批量面板里的步进按钮（单日面板用 .ds-btn，尺寸更小） */
.step {
  width: 84rpx;
  height: 68rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FAF9F4;
  color: #2F3338;
  font-size: 34rpx;
  line-height: 66rpx;
  text-align: center;
}

.tag {
  padding: 8rpx 14rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 999rpx;
  background: #FCFBF8;
  color: #4C5057;
  font-size: 22rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.tag.on {
  border-color: #A7C3DC;
  background: #E4EEF7;
  color: #174C7C;
}

.sheet-actions {
  display: flex;
  margin-top: 20rpx;
}

.sheet-actions .btn {
  flex: 1;
}

.sheet-actions .btn:first-child {
  margin-right: 12rpx;
  flex: 0 0 200rpx;
}

.safe {
  height: 28rpx;
}

.undo {
  position: fixed;
  z-index: 70;
  right: 40rpx;
  bottom: 150rpx;
  left: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 26rpx;
  border-radius: 12rpx;
  background: #2F3338;
}

.undo-t {
  color: #FFFFFF;
  font-size: 24rpx;
  flex: 1;
}

.undo-right {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
}

.undo-act {
  color: #8FC4F0;
  font-size: 24rpx;
  font-weight: 500;
  padding: 4rpx 8rpx;
}

.undo-x {
  color: rgba(255, 255, 255, 0.6);
  font-size: 32rpx;
  line-height: 1;
  margin-left: 16rpx;
  padding: 4rpx 8rpx;
}

/* ---------- 多选操作条 ---------- */
.selbar {
  position: fixed;
  z-index: 80;
  right: 16rpx;
  bottom: 16rpx;
  left: 16rpx;
  padding: 18rpx 20rpx 16rpx;
  border-radius: 18rpx;
  background: #22252A;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.28);
}

.sb-head {
  display: flex;
  align-items: center;
}

.sb-cnt {
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 500;
}

.sb-link {
  margin-left: 22rpx;
  color: #8FC4F0;
  font-size: 23rpx;
}

.sb-x {
  margin-left: auto;
  padding: 0 6rpx;
  color: rgba(255, 255, 255, 0.62);
  font-size: 32rpx;
  line-height: 1;
}

.sb-scope {
  display: flex;
  margin-top: 14rpx;
}

.sb-chip {
  margin-right: 10rpx;
  padding: 7rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.sb-chip.on {
  border-color: #8FC4F0;
  background: rgba(143, 196, 240, 0.18);
  color: #D6E9FA;
}

.sb-chip.sb-les {
  margin-left: auto;
  margin-right: 0;
  color: rgba(255, 255, 255, 0.62);
}

.sb-chip.sb-les.on {
  border-color: #F0B37E;
  background: rgba(240, 179, 126, 0.18);
  color: #F7D6B4;
}

/* 「含周末」：默认关；打开后连选也选周六日（法定假期仍跳过） */
.sb-chip.sb-wk {
  color: rgba(255, 255, 255, 0.62);
}

.sb-chip.sb-wk.on {
  border-color: #F0B37E;
  background: rgba(240, 179, 126, 0.18);
  color: #F7D6B4;
}

.sb-row {
  display: flex;
  margin-top: 14rpx;
}

.sb-b {
  height: 68rpx;
  flex: 1;
  margin-right: 8rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.06);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 66rpx;
  text-align: center;
}

.sb-b:last-child {
  margin-right: 0;
}

.sb-b.w {
  border-color: rgba(143, 196, 240, 0.55);
  color: #CFE6F9;
}

.sb-b.i {
  border-color: rgba(127, 214, 185, 0.5);
  color: #C7EDE0;
}

.sb-b.o {
  border-color: rgba(240, 179, 126, 0.5);
  color: #F3D3B0;
}

.sb-b.l {
  border-color: rgba(255, 255, 255, 0.3);
}

.sb-b:active {
  background: rgba(255, 255, 255, 0.16);
}

.sb-hint {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.42);
  font-size: 20rpx;
}

/* ---------- 滑动选择 ---------- */
/* 选择模式下禁掉滚动手势，避免滑动选日期时页面跟着动 */
.grid.no-scroll {
  touch-action: none;
}

/* ---------- 批量设置（日期范围 + 星期） ---------- */
.bulk-dates {
  display: flex;
  align-items: center;
}

.bulk-date {
  min-width: 226rpx;
  height: 74rpx;
  padding: 0 18rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #191C20;
  font-size: 26rpx;
  line-height: 72rpx;
  text-align: center;
}

.bulk-tilde {
  margin: 0 14rpx;
  color: #656A72;
  font-size: 23rpx;
}

.bulk-chips {
  display: flex;
  flex-wrap: wrap;
}

.bulk-chip {
  height: 66rpx;
  margin: 0 10rpx 10rpx 0;
  padding: 0 22rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #656A72;
  font-size: 24rpx;
  line-height: 64rpx;
}

.bulk-chip.on {
  border-color: #1B5E9B;
  background: #EAF2FA;
  color: #1B5E9B;
  font-weight: 500;
}

.bulk-chk {
  display: flex;
  align-items: center;
  color: #4C5057;
  font-size: 24rpx;
}

.bulk-box {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  border: 1rpx solid #C9C6BC;
  border-radius: 6rpx;
  background: #FCFBF8;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.bulk-box.on {
  border-color: #1B5E9B;
  background: #1B5E9B;
}



/* 批量课时步进：null 显示「不改」，设了值蓝色高亮 */
.bulk-les { display: flex; align-items: center; gap: 20rpx; }
.bulk-les-val {
  min-width: 120rpx;
  text-align: center;
  color: #174C7C;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.bulk-les-val.unset { color: #8A8377; font-weight: 400; }
.bulk-les-reset { color: #1B5E9B; font-size: 22rpx; margin-left: 4rpx; }
.bulk-les-hint { display: block; margin-top: 10rpx; color: #8A8377; font-size: 20rpx; line-height: 1.6; }

.bulk-pv {
  display: block;
  margin-top: 16rpx;
  color: #666B73;
  font-size: 23rpx;
}

.bulk-num {
  color: #1B5E9B;
  font-weight: 600;
}

/* ---------- 记账面板里的课时档位 ---------- */
.rate-seg {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 8rpx;
  line-height: 1.3;
}

.rate-seg-name {
  font-size: 23rpx;
}

.rate-seg-price {
  margin-top: 2rpx;
  font-size: 19rpx;
  opacity: 0.68;
}

/* 档位块没有状态类，选中态单独给一版 */
.seg.on.rate-seg {
  height: auto;
  min-height: 74rpx;
  border-color: #174C7C;
  background: #2265A3;
  color: #FFFFFF;
}

.seg.on.rate-seg .rate-seg-price {
  color: #EAF2FA;
  opacity: 0.9;
}

/* ---------- 单日面板（一屏放完，不滚动） ----------
   版式：表头（日期 + 翻天 + 关闭）／出勤两行／课时组（浅底）／备注与标签／底部按钮。
   实测高度：正常机型约 890rpx（出现「计价」行约 990rpx），iPhone 8 一屏可放 1108rpx；
   窗口不足 330×540（SE、4.x 寸安卓）时由页面加 .ds-compact，整体缩到约 760rpx。
   两套都不写 @media：媒体查询会让旧版开发者工具的 WXSS 编译器报内部错误。 */

.ds-sheet {
  display: flex;
  flex-direction: column;
  max-height: 96vh;
  padding: 32rpx 36rpx 28rpx;
  overflow: hidden;
  border-radius: 26rpx 26rpx 0 0;
  box-shadow: 0 -10rpx 40rpx rgba(25, 28, 32, .12);
}

/* ---- 表头 ---- */
.ds-head {
  display: flex;
  flex: none;
  align-items: flex-start;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F1EFE8;
}

.ds-head-main {
  flex: 1;
  min-width: 0;
}

.ds-date {
  display: block;
  color: #191C20;
  font-size: 52rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.ds-meta {
  display: block;
  margin-top: 4rpx;
  overflow: hidden;
  color: #656A72;
  font-size: 25rpx;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ds-ops {
  display: flex;
  flex: none;
  align-items: center;
  margin-top: 6rpx;
  margin-left: 16rpx;
}

/* 翻天两个方按钮 + 关闭，按手指尺寸给（78rpx ≈ 39pt） */
.ds-op {
  width: 84rpx;
  height: 84rpx;
  margin-left: 12rpx;
  border-radius: 16rpx;
  background: #F3F2ED;
  color: #3A3F45;
  font-size: 42rpx;
  line-height: 82rpx;
  text-align: center;
}

.ds-op-hover {
  background: #E4E1D8;
}

.ds-x {
  width: 84rpx;
  height: 84rpx;
  margin-left: 12rpx;
  color: #B4B2A9;
  font-size: 32rpx;
  line-height: 84rpx;
  text-align: center;
}

/* ---- 行：窄标签 + 控件 ---- */
.ds-row {
  display: flex;
  flex: none;
  align-items: center;
  min-height: 116rpx;
}

.ds-label {
  flex: 0 0 80rpx;
  color: #5F6470;
  font-size: 26rpx;
}

.ds-segs {
  display: flex;
  flex: 1;
  min-width: 0;
}

.ds-segs .seg {
  height: 100rpx;
  margin-right: 10rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 98rpx;
}

/* ---- 课时 / 晚修 / 计价：浅底一块，和上面的出勤分开 ---- */
.ds-group {
  flex: none;
  margin-top: 8rpx;
  padding: 6rpx 16rpx;
  border-radius: 22rpx;
  background: #F8F7F2;
}

.ds-group .ds-row {
  min-height: 112rpx;
}

.ds-step {
  display: flex;
  flex: none;
  align-items: center;
}

.ds-btn {
  width: 104rpx;
  height: 92rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #2F3338;
  font-size: 44rpx;
  line-height: 90rpx;
  text-align: center;
}

.ds-btn-hover {
  background: #EFEDE6;
}

.ds-val {
  min-width: 112rpx;
  color: #191C20;
  font-size: 50rpx;
  font-weight: 600;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.ds-quicks {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.ds-quick {
  padding: 8rpx 14rpx;
  border: 1rpx dashed #CFE2F2;
  border-radius: 999rpx;
  background: #F7FBFF;
  color: #1B5E9B;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.ds-hint {
  flex: 1;
  margin-left: 12rpx;
}

.ds-hint-l {
  display: block;
  color: #8A8377;
  font-size: 21rpx;
  line-height: 1.45;
}

/* 档位多时允许换行：挤成小缝比换行更难认 */
.ds-rates {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx;
  min-width: 0;
}

.ds-rates .seg {
  flex: 1 1 150rpx;
  height: 96rpx;
  margin-right: 0;
  border-radius: 14rpx;
}

/* 档位块排成一行「名称 + 单价」，比上下两行矮一截 */
.ds-rates .rate-seg {
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  line-height: 94rpx;
}

.ds-rates .rate-seg-name {
  font-size: 26rpx;
}

.ds-rates .rate-seg-price {
  margin-top: 0;
  font-size: 21rpx;
}

.ds-rates .seg.on.rate-seg {
  min-height: 0;
  height: 96rpx;
}

/* ---- 备注与标签 ---- */
.ds-note {
  width: 100%;
  height: 100rpx;
  margin-top: 18rpx;
  padding: 0 24rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 16rpx;
  background: #FCFBF8;
  color: #191C20;
  font-size: 30rpx;
}

.ds-tags {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
}

.ds-tag-label {
  flex: 0 0 76rpx;
  color: #8A8377;
  font-size: 22rpx;
  line-height: 52rpx;
}

.ds-tag-wrap {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ds-tag-wrap .tag {
  padding: 8rpx 16rpx;
  font-size: 23rpx;
  line-height: 1.4;
  white-space: nowrap;
}

/* 最近写过的标签用虚线框，和常用标签排在同一块区域 */
.ds-tag-wrap .tag.rc {
  border-style: dashed;
  color: #8A8377;
}

.ds-tag-wrap .tag.on {
  border-style: solid;
}

/* ---- 底部按钮 ---- */
.ds-actions {
  display: flex;
  flex: none;
  align-items: center;
  margin-top: auto;
  padding-top: 24rpx;
}

.ds-actions .btn {
  height: 104rpx;
  border-radius: 16rpx;
  font-size: 33rpx;
}

.ds-clear {
  flex: 0 0 230rpx;
  margin-right: 20rpx;
}

.ds-ok {
  flex: 1;
}

/* ---- 小屏（窗口 ≤340×570）压一档：只缩尺寸，不减内容 ---- */
.ds-compact {
  padding: 22rpx 26rpx 20rpx;
}

.ds-compact .ds-head {
  padding-bottom: 14rpx;
}

.ds-compact .ds-date {
  font-size: 38rpx;
}

.ds-compact .ds-meta {
  margin-top: 2rpx;
  font-size: 22rpx;
}

.ds-compact .ds-op,
.ds-compact .ds-x {
  width: 66rpx;
  height: 66rpx;
  margin-left: 10rpx;
  font-size: 34rpx;
  line-height: 64rpx;
}

.ds-compact .ds-row {
  min-height: 92rpx;
}

.ds-compact .ds-group .ds-row {
  min-height: 88rpx;
}

.ds-compact .ds-label {
  flex: 0 0 68rpx;
  font-size: 23rpx;
}

.ds-compact .ds-segs .seg {
  height: 76rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 74rpx;
}

.ds-compact .ds-btn {
  width: 82rpx;
  height: 70rpx;
  border-radius: 12rpx;
  font-size: 34rpx;
  line-height: 68rpx;
}

.ds-compact .ds-val {
  min-width: 88rpx;
  font-size: 38rpx;
}

.ds-compact .ds-rates .seg,
.ds-compact .ds-rates .seg.on.rate-seg {
  height: 72rpx;
}

.ds-compact .ds-rates .rate-seg {
  font-size: 23rpx;
  line-height: 70rpx;
}

.ds-compact .ds-note {
  height: 82rpx;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.ds-compact .ds-tags {
  margin-top: 10rpx;
}

.ds-compact .ds-tag-label {
  flex: 0 0 68rpx;
  font-size: 20rpx;
  line-height: 46rpx;
}

.ds-compact .ds-tag-wrap .tag {
  padding: 7rpx 16rpx;
  font-size: 22rpx;
}

.ds-compact .ds-actions {
  padding-top: 16rpx;
}

.ds-compact .ds-actions .btn {
  height: 84rpx;
  font-size: 28rpx;
}
