<!-- 选择模式下锁住页面滚动：页面一滚，微信就会打断手势（touchcancel），手指继续划也选不中 -->
<page-meta page-style="{{sel ? 'overflow: hidden;' : ''}}"></page-meta>
<view class="page {{sel ? 'pad-sel' : ''}}">
  <view class="topbar">
    <view class="nav" bindtap="prevMonth" hover-class="nav-hover">‹</view>
    <picker mode="date" fields="month" value="{{ym}}" bindchange="pickMonth">
      <view class="mon">{{monLabel}}<text class="caret">▾</text></view>
    </picker>
    <view class="nav" bindtap="nextMonth" hover-class="nav-hover">›</view>
    <view class="go-today" bindtap="goToday">今天</view>
    <view class="sel-toggle {{sel ? 'on' : ''}}" bindtap="toggleSel">{{sel ? '退出' : '选择'}}</view>
  </view>

  <view class="chips">
    <view class="chip {{item.num ? 'chip-wide' : ''}}" wx:for="{{chips}}" wx:key="k">
      <text class="chip-k">{{item.k}}</text>
      <text class="chip-v">{{item.v}}</text>
    </view>
  </view>

  <view class="legend">
    <view class="lg" wx:for="{{legend}}" wx:key="k">
      <view class="sw {{item.k}}"></view>
      <text class="lg-t">{{item.label}}</text>
    </view>
  </view>

  <view class="weekhead">
    <text class="wh" wx:for="{{weekHead}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="grid {{sel ? 'no-scroll' : ''}}" bindtouchmove="gridMove">
    <view wx:for="{{cells}}" wx:key="id" class="{{item.blank ? 'cell blank' : item.cls}} {{item.sel ? 'sel' : ''}}"
          data-key="{{item.key}}" data-idx="{{index}}"
          bindtap="tapCell" bindtouchstart="gridStart" bindtouchend="gridEnd"
          bindtouchcancel="gridCancel">
      <block wx:if="{{!item.blank}}">
        <view class="dnum">
          <text class="dn">{{item.d}}</text>
          <text class="note-mark" wx:if="{{item.hasNote}}"></text>
          <text class="cd cd-{{item.tagCls}}" wx:if="{{item.tag}}">{{item.tag}}</text>
        </view>
        <view class="halves">
          <view class="half {{item.amCls}}"></view>
          <view class="half {{item.pmCls}}"></view>
        </view>
        <view class="les-wrap" wx:if="{{item.lesText || item.nightText}}">
          <text class="les {{item.lesCls}} {{item.lesText ? '' : 'bare'}}">{{item.lesText}}</text>
          <text class="nighttag" wx:if="{{item.nightText}}">{{item.nightText}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="notes" wx:if="{{notes.length}}">
    <text class="note-item" wx:for="{{notes}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="tools tools-main">
    <view class="btn primary" bindtap="fillCourse">按课程表填课时</view>
    <view class="btn" bindtap="openBulk">批量设置</view>
  </view>
  <view class="tools">
    <view class="btn" bindtap="restoreDefault">恢复默认出勤</view>
    <view class="btn" bindtap="gotoYear">年历总览</view>
  </view>

  <!-- 用法收进折叠区：默认只留一行，说明不再占掉半屏；「清空本月」从按钮降成文字链，
       不和常用操作挤在同一个按钮行里 -->
  <view class="foot-row">
    <view class="howto" bindtap="toggleTips">
      <text>{{tipsOpen ? '收起用法' : '怎么用'}}</text>
      <text class="howto-mark">{{tipsOpen ? '︿' : '？'}}</text>
    </view>
    <view class="danger-link" bindtap="clearMonth">清空本月</view>
  </view>

  <view class="tips" wx:if="{{tipsOpen}}">
    <text>点格子改当天状态与课时。在日期上左右滑动、或按住一会儿，都会进入多选：划过的日期连续选中，周末自动跳过（周末有课可单点补上），选好点下方状态整片套用。</text>
  </view>
  <view class="tips" wx:if="{{tipsOpen}}">
    <text>「批量设置」按日期范围加星期一次改多天，可以跨月，比如「9 月 1 日到 10 月 31 日、只改周三」。</text>
  </view>
  <view class="tips" wx:if="{{tipsOpen}}">
    <text>年历右边的 W1、W2 是教学周。需要先「设置 → 课程表与教学周」填一下开学那周的时间；没填默认「—」。</text>
  </view>
</view>

<view class="selbar" wx:if="{{sel}}">
  <view class="sb-head">
    <text class="sb-cnt">已选 {{selKeys.length}} 天</text>
    <text class="sb-link" bindtap="selAllWorkdays">全月工作日</text>
    <text class="sb-link" bindtap="selClearAll">清空</text>
    <text class="sb-x" bindtap="exitSel">×</text>
  </view>
  <view class="sb-scope">
    <view class="sb-chip {{scope === 'both' ? 'on' : ''}}" data-s="both" bindtap="pickScope">全天</view>
    <view class="sb-chip {{scope === 'am' ? 'on' : ''}}" data-s="am" bindtap="pickScope">只上午</view>
    <view class="sb-chip {{scope === 'pm' ? 'on' : ''}}" data-s="pm" bindtap="pickScope">只下午</view>
    <view class="sb-chip sb-wk {{allowWk ? 'on' : ''}}" bindtap="toggleAllowWk">含周末</view>
    <view class="sb-chip sb-les {{clearLes ? 'on' : ''}}" bindtap="toggleClearLes">课时清零</view>
  </view>
  <view class="sb-row">
    <view class="sb-b w" data-st="work" bindtap="applySel">上班</view>
    <view class="sb-b i" data-st="inv" bindtap="applySel">监考</view>
    <view class="sb-b o" data-st="ot" bindtap="applySel">加班</view>
    <view class="sb-b l" data-st="leave" bindtap="applySel">请假</view>
    <view class="sb-b" data-st="empty" bindtap="applySel">空</view>
  </view>
  <text class="sb-hint">{{allowWk ? '含周末已开：周六日也会被划选，法定假期仍跳过' : '左右滑动或长按可连选；周末与起算日前的日期自动跳过，周末可单点补选'}}</text>
</view>

<view class="mask" wx:if="{{bulk}}" bindtap="closeBulk" catchtouchmove="noop"></view>

<view class="sheet" wx:if="{{bulk}}">
  <view class="sheet-head">
    <view class="sheet-title-wrap">
      <text class="sheet-title">批量设置</text>
      <text class="sheet-sub">按日期范围加星期，跨月也行</text>
    </view>
    <view class="sheet-x" bindtap="closeBulk">✕</view>
  </view>

  <view class="field">
    <text class="field-label">日期范围</text>
    <view class="bulk-dates">
      <picker mode="date" value="{{bulk.from}}" bindchange="pickBulkFrom">
        <view class="bulk-date">{{bulk.from}}</view>
      </picker>
      <text class="bulk-tilde">至</text>
      <picker mode="date" value="{{bulk.to}}" bindchange="pickBulkTo">
        <view class="bulk-date">{{bulk.to}}</view>
      </picker>
    </view>
  </view>

  <view class="field">
    <text class="field-label">只在以下星期生效</text>
    <view class="bulk-chips">
      <view wx:for="{{bulkWd}}" wx:key="v" class="bulk-chip {{item.on ? 'on' : ''}}"
            data-wd="{{item.v}}" bindtap="toggleBulkWd">{{item.label}}</view>
    </view>
  </view>

  <view class="field">
    <text class="field-label">设为</text>
    <view class="bulk-chips">
      <view wx:for="{{bulkSts}}" wx:key="k" class="bulk-chip {{bulk.st === item.k ? 'on' : ''}}"
            data-st="{{item.k}}" bindtap="pickBulkSt">{{item.label}}</view>
    </view>
  </view>

  <view class="field">
    <text class="field-label">设为课时（不选就不改）</text>
    <view class="bulk-les">
      <view class="step" data-d="-1" bindtap="stepBulkLes">−</view>
      <text class="bulk-les-val {{bulk.les === null ? 'unset' : ''}}">{{bulk.les === null ? '不改' : bulk.les + ' 节'}}</text>
      <view class="step" data-d="1" bindtap="stepBulkLes">＋</view>
      <text class="bulk-les-reset" wx:if="{{bulk.les !== null}}" bindtap="resetBulkLes">还原</text>
    </view>
    <text class="bulk-les-hint">每次 ±2；减到 0 即清零，设了值就不再被课程表自动覆盖</text>
  </view>

  <text class="bulk-pv">将影响 <text class="bulk-num">{{bulk.count}}</text> 天{{bulk.first ? '（' + bulk.first + ' 起）' : ''}}</text>

  <view class="sheet-actions">
    <view class="btn ghost" bindtap="closeBulk">取消</view>
    <view class="btn primary" bindtap="applyBulk">应用</view>
  </view>
  <view class="safe"></view>
</view>

<view class="mask" wx:if="{{sheet}}" bindtap="closeSheet" catchtouchmove="noop"></view>

<!-- 单日面板：整屏一版放下，不滚动。
     结构 = 紧凑表头（日期 + 翻天箭头）→ 五行「标签 + 控件」→ 备注 → 底部按钮，
     标签占固定窄列，控件共用一条右边界，比原来「标题一行、控件一行」省掉近一屏。 -->
<view class="sheet ds-sheet {{compact ? 'ds-compact' : ''}}" wx:if="{{sheet}}">
  <view class="ds-head">
    <view class="ds-head-main">
      <text class="ds-date">{{sheet.title}}</text>
      <text class="ds-meta">{{sheet.sub}}</text>
    </view>
    <view class="ds-ops">
      <view class="ds-op" hover-class="ds-op-hover" data-d="-1" bindtap="stepDay">‹</view>
      <view class="ds-op" hover-class="ds-op-hover" data-d="1" bindtap="stepDay">›</view>
      <view class="ds-x" bindtap="closeSheet">✕</view>
    </view>
  </view>

  <view class="ds-row">
    <text class="ds-label">上午</text>
    <view class="ds-segs">
      <view wx:for="{{opts}}" wx:key="k" class="seg {{item.cls}} {{sheet.am === item.k ? 'on' : ''}}"
            data-which="am" data-v="{{item.k}}" bindtap="pickHalf">{{item.label}}</view>
    </view>
  </view>

  <view class="ds-row">
    <text class="ds-label">下午</text>
    <view class="ds-segs">
      <view wx:for="{{opts}}" wx:key="k" class="seg {{item.cls}} {{sheet.pm === item.k ? 'on' : ''}}"
            data-which="pm" data-v="{{item.k}}" bindtap="pickHalf">{{item.label}}</view>
    </view>
  </view>

  <!-- 课时 / 晚修 / 计价 放在一块浅色底上：和上面的「出勤」分开，
       眼睛一眼能看出这是两件事，不用再加一行小标题占高度 -->
  <view class="ds-group">
    <view class="ds-row">
      <text class="ds-label">课时</text>
      <view class="ds-step">
        <view class="ds-btn" hover-class="ds-btn-hover" data-d="-1" bindtap="stepLesson">−</view>
        <text class="ds-val">{{sheet.lessons}}</text>
        <view class="ds-btn" hover-class="ds-btn-hover" data-d="1" bindtap="stepLesson">＋</view>
      </view>
      <view class="ds-quicks">
        <text class="ds-quick" wx:if="{{sheet.exp > 0}}" bindtap="useSchedule">课表 {{sheet.exp}} 节</text>
        <text class="ds-quick" bindtap="useCommon4">常用 4 节</text>
      </view>
    </view>

    <view class="ds-row" wx:if="{{sheet.nightOn}}">
      <text class="ds-label">晚修</text>
      <view class="ds-step">
        <view class="ds-btn" hover-class="ds-btn-hover" data-d="-1" bindtap="stepNight">−</view>
        <text class="ds-val">{{sheet.night}}</text>
        <view class="ds-btn" hover-class="ds-btn-hover" data-d="1" bindtap="stepNight">＋</view>
      </view>
      <view class="ds-hint">
        <text class="ds-hint-l" wx:for="{{nightHints}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="ds-row" wx:if="{{sheet.lessons > 0 && rates.length > 1}}">
      <text class="ds-label">计价</text>
      <view class="ds-rates">
        <view wx:for="{{rates}}" wx:key="id" class="seg rate-seg {{sheet.rid === item.id ? 'on' : ''}}"
          data-id="{{item.id}}" bindtap="pickRate">
          <text class="rate-seg-name">{{item.name}}</text>
          <text class="rate-seg-price">{{item.price}} 元</text>
        </view>
      </view>
    </view>
  </view>

  <input class="ds-note" value="{{sheet.note}}" placeholder="备注：记一笔，方便日后查找" maxlength="60" bindinput="onNote" />

  <view class="ds-tags">
    <text class="ds-tag-label">常用</text>
    <view class="ds-tag-wrap">
      <text class="tag {{sheet.note === item ? 'on' : ''}}" wx:for="{{sheet.tags}}" wx:key="*this"
            data-v="{{item}}" bindtap="tapTag">{{item}}</text>
    </view>
  </view>
  <!-- 「最近写过」用虚线框区分，和常用标签排在一起，不再单独占一个标题行 -->
  <view class="ds-tags" wx:if="{{sheet.recentTags.length}}">
    <text class="ds-tag-label">最近</text>
    <view class="ds-tag-wrap">
      <text class="tag rc {{sheet.note === item ? 'on' : ''}}" wx:for="{{sheet.recentTags}}" wx:key="*this"
            data-v="{{item}}" bindtap="tapTag">{{item}}</text>
    </view>
  </view>

  <view class="ds-actions">
    <view class="btn ghost ds-clear" bindtap="clearSheet">清空这天</view>
    <view class="btn primary ds-ok" bindtap="saveSheet">完成</view>
  </view>
</view>

<!-- 面板打开时不显示撤销条：它固定在页面底部，会正好压在备注和标签上 -->
<view class="undo" wx:if="{{undo && !sheet && !bulk}}">
  <text class="undo-t">{{undo.label}}</text>
  <view class="undo-right">
    <text class="undo-act" bindtap="doUndo">撤销</text>
    <text class="undo-x" catchtap="hideUndo">×</text>
  </view>
</view>
