.page {
  padding: 20rpx 0 40rpx;
}

.col {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding-right: 16rpx;
}

.sub {
  margin-top: 2rpx;
  color: #8A8E96;
  font-size: 21rpx;
  line-height: 1.6;
}

.txt-in {
  width: 240rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #191C20;
  font-size: 27rpx;
  text-align: right;
}

.num-in {
  width: 240rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
  color: #191C20;
  font-size: 27rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 标题和说明各占一行：text 默认 inline，不撑成纵向排列就会挤成一段 */
.week-block {
  display: flex;
  flex-direction: column;
  padding: 18rpx 0 6rpx;
  border-bottom: 1rpx solid #F1EFE8;
}

.week-block .sub {
  margin-top: 6rpx;
}

.week {
  display: flex;
  margin-top: 22rpx;
}

.wd {
  display: flex;
  height: 92rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 8rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FCFBF8;
}

.wd:last-child {
  margin-right: 0;
}

.wd.on {
  border-color: #174C7C;
  background: #2265A3;
}

.wd.half {
  border-color: #0F6E56;
  background: #D8EDE5;
}

.wd-l {
  color: #8A8E96;
  font-size: 20rpx;
  line-height: 1.4;
}

.wd-v {
  color: #8A8E96;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wd.on .wd-l,
.wd.on .wd-v {
  color: #FFFFFF;
}

.wd.half .wd-l,
.wd.half .wd-v {
  color: #0A4A39;
}

.pick-btn {
  padding: 10rpx 24rpx;
  border: 1rpx solid #E4E1D8;
  border-radius: 12rpx;
  background: #FAF9F4;
  color: #1B5E9B;
  font-size: 24rpx;
}

.param-note {
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border: 1rpx dashed #E4E1D8;
  border-radius: 12rpx;
  background: #FAF9F4;
  color: #666B73;
  font-size: 21rpx;
  text-align: center;
}

.data-tips {
  margin: 6rpx 0 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FAF9F4;
  color: #666B73;
  font-size: 21rpx;
  line-height: 1.7;
}

.data-actions {
  display: flex;
}

.data-actions .btn {
  flex: 1;
  margin-right: 12rpx;
}

.data-actions .btn:last-child {
  margin-right: 0;
}

.btn.full {
  margin-top: 12rpx;
}

.tips {
  padding: 18rpx 30rpx 0;
  color: #8A8E96;
  font-size: 21rpx;
  line-height: 1.75;
}
